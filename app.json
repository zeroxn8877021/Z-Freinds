{
  "expo": {
    "name": "Z Friends",
    "slug": "z-friends",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#000000" },
    "android": {
      "package": "com.zfriends.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#000000" },
      "permissions": ["READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO"]
    },
    "plugins": [
      ["expo-image-picker", { "photosPermission": "Z Friends needs your photos to set a profile picture and share stories." }],
      "expo-video"
    ]
  }
}
